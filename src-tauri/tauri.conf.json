{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Little Lobby",
  "version": "../package.json",
  "identifier": "io.github.nosugark.scankick",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run build:app && npm run dev:app",
    "beforeBuildCommand": "npm run build:app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "小聚场 · Little Lobby",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "0.2.0"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
